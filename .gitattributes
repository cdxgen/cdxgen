# The introspection goldens are compared byte-for-byte against renderer output,
# which emits \n on every platform, so a CRLF checkout would fail every row.
test/data/introspection/** text eol=lf

# The vendored arborist tree is digest-pinned in contrib/arborist-manifest.json,
# regenerated by contrib/vendor-arborist.mjs, and patched by verbatim string
# match. All three compare bytes, so a CRLF checkout would break every digest
# and every patch.
lib/third-party/arborist/** text eol=lf
contrib/arborist-manifest.json text eol=lf
contrib/arborist-patches/*.patch text eol=lf

# A .vsix is a zip archive whose SHA-256 the tests compare.
test/data/ide-extensions/**/*.vsix binary
