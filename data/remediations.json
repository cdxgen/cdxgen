  "build.rate-limited": {
    "ecosystem": "generic",
    "kind": "evidence.degraded",
    "impact": "transitive-deps",
    "title": "A build tool's repository rate limited the machine, so its dependency tree did not resolve",
    "targetTier": null,
    "actions": [
      {
        "kind": "config",
        "command": "Maven: declare a <mirror> in the Maven settings.xml, or set MVNW_REPOURL for the Maven wrapper"
      },
      {
        "kind": "config",
        "command": "Gradle: declare the mirror repository in a Gradle init script"
      },
      {
        "kind": "config",
        "command": "sbt: list the mirror in ~/.sbt/repositories and pass -Dsbt.override.build.repos=true in SBT_OPTS or .sbtopts"
      },
      {
        "kind": "config",
        "command": "Mill and scala-cli: set central.from and central.to in Coursier's mirror.properties, separating several central.from URLs with semicolons"
      },
      {
        "kind": "env",
        "command": "Point MAVEN_CENTRAL_URL at a mirror for cdxgen's own lookups"
      },
      {
        "kind": "rerun"
      }
    ],
    "verify": {
      "rules": [],
      "expectTier": null,
      "eventsCleared": [
        "build.rate-limited"
      ]
    },
    "docs": "https://cyclonedx.github.io/cdxgen/#/ADVANCED"
  },
