  "python.pyproject-unparseable": {
    "ecosystem": "python",
    "kind": "evidence.degraded",
    "impact": "transitive-deps",
    "title": "The pyproject.toml could not be parsed, so the workspace structure was not reconstructed",
    "targetTier": "manifest",
    "actions": [
      {
        "kind": "config",
        "detail": "Check the file with a TOML 1.0 validator. cdxgen's TOML parser predates TOML 1.0 and rejects arrays that mix inline tables with strings, which PEP 735 `dependency-groups` produce when they use `include-group`."
      },
      {
        "kind": "rerun"
      }
    ],
    "verify": {
      "rules": [],
      "expectTier": "manifest",
      "eventsCleared": [
        "python.pyproject-unparseable"
      ]
    },
    "docs": "https://cyclonedx.github.io/cdxgen/#/PROJECT_TYPES"
  },
