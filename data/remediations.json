{
  "jvm.maven.build-first": {
    "ecosystem": "java",
    "kind": "fallback.engaged",
    "impact": "transitive-deps",
    "title": "Maven could not resolve dependencies; build the project before invoking cdxgen",
    "targetTier": "resolved",
    "actions": [
      {
        "kind": "install",
        "tool": "java",
        "versionFrom": "expected",
        "via": "sdkman",
        "command": "sdk install java {{version}}",
        "windows": "winget install --id EclipseAdoptium.Temurin.{{major}}.JDK"
      },
      {
        "kind": "install",
        "tool": "maven",
        "versionFrom": "expected",
        "via": "sdkman",
        "command": "sdk install maven {{version}}",
        "windows": "winget install --id Apache.Maven"
      },
      {
        "kind": "build",
        "command": "{{mvn}} -q package -DskipTests"
      },
      {
        "kind": "rerun"
      }
    ],
    "verify": {
      "rules": [
        "BF-JVM-001",
        "BF-JVM-002"
      ],
      "expectTier": "resolved"
    },
    "docs": "https://cyclonedx.github.io/cdxgen/#/PROJECT_TYPES?id=java"
  },
