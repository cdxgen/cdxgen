# Loaded by poku for every test file (see .pokurc.jsonc).
#
# Tests stub registries under their real host names, and the JS batch pool
# keeps what it fetches in the on-disk metadata cache. Without this, a test
# could be answered from this machine's cache, and could leave its stubbed
# answers there for later scans. The tests of the cache itself unset it and
# point CDXGEN_CACHE_DIR at a temporary directory.
CDXGEN_NO_CACHE=true
