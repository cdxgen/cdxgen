<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>App</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- An assembly reference states no package version anywhere: #4359 -->
    <Reference Include="Newtonsoft.Json" />
    <!-- Resolves from the targeting pack on net48, not from nuget.org -->
    <Reference Include="System.Net.Http" />
    <!-- An inline assembly version names the assembly, not the package -->
    <Reference Include="log4net, Version=2.0.15.0, Culture=neutral, PublicKeyToken=669e0ddf0bb1aa2a" />
    <!-- An MSBuild property only a build evaluates, with nothing pinning it -->
    <Reference Include="FSharp.Core, Version=$(TargetFSharpCoreVersion), Culture=neutral" />
  </ItemGroup>
</Project>
