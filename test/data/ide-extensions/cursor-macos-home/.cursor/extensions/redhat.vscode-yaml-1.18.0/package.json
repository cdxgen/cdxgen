{
  "name": "vscode-yaml",
  "displayName": "YAML",
  "publisher": "redhat",
  "version": "1.18.0",
  "license": "MIT",
  "main": "./dist/extension",
  "browser": "./dist/extension-web",
  "engines": {
    "npm": ">=7.0.0",
    "vscode": "^1.91.0"
  },
  "activationEvents": [
    "onLanguage:yaml"
