{
  "name": "cursorpyright",
  "displayName": "Python",
  "publisher": "anysphere",
  "version": "1.0.12",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.99.0"
  },
  "activationEvents": [
    "onLanguage:python",
    "workspaceContains:pyrightconfig.json",
    "workspaceContains:pyproject.toml"
  ],
  "extensionPack": [
    "anysphere.python"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/getcursor/cursor.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "cursorpyright.importPylanceSettings",
        "title": "Import Pylance settings"
      }
    ]
  }
}
