tmp/

# BOM generated by CDXGEN during local development
bom.json
bomresults

# Third-party projects the repotest workflows clone or scaffold. They are scan
# input, not cdxgen source, and the golden corpus they used to sit beside lives
# under test/repotests/ where the unit tests walk it.
/repotests/
*.slices.json

# Golden test harness artifacts
.v12-tmp/
.bom-output.json

# Build state the JVM tool fixtures accumulate when a build tool actually
# resolves them. The fixtures are their build files; the output is not one.
test/data/jvm-tools/**/target/
test/data/jvm-tools/**/.bsp/

# Toolchain matrix run artifacts (contrib/toolchain-matrix.js). These are
# artifacts, not fixtures; the recorded baseline lives in test/matrix/.
results/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

