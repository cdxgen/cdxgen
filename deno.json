{
  "name": "@cdxgen/cdxgen",
  "version": "13.4.0",
  "exports": "./lib/cli/index.js",
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "include": ["*.js", "data/", "bin/", "lib/**"],
  "exclude": [
    "test/",
    "docs/",
    "contrib/",
    "ci/",
    ".github/",
    ".*",
    "devenv*",
    "jest.config.js",
    "docker-compose.yml",
    "ADVANCED.md",
    "pnpm-lock.yaml",
    "biome.json",
    "plugins",
    "tsconfig.json",
    "index.cjs",
    "claude-plugin/",
    "uv.lock",
    "**/*.poku.js",
    "**/*.d.ts.map",
    "lib/third-party/arborist/CHANGELOG.md"
  ],
  "compile": {
    "include": ["data", "package.json"]
  },
  "lint": {
    "include": ["bin/", "*.js", "lib/**"],
    "exclude": ["test/", "data/", "contrib/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-unused-vars", "no-invalid-regexp"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 4,
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["bin/", "*.js"],
    "exclude": ["test/", "data/", "contrib/"]
  },
  "minimumDependencyAge": {
    "age": "P3D",
    "exclude": ["npm:@cdxgen/*", "npm:@appthreat/*"]
  },
  "lock": false,
  "nodeModulesDir": "auto",
  "unstable": [],
  "test": {
    "include": ["test/deno/*.poku.js"]
  },
  "tasks": {
    "start": "deno run --allow-read --allow-env --allow-run --allow-sys=uid,systemMemoryInfo,gid,homedir --allow-write --allow-net bin/cdxgen.js",
    "exe": "deno compile --allow-read --allow-env --allow-run --allow-sys=uid,systemMemoryInfo,gid,homedir --allow-write --allow-net --output build/cdxgenx-devel bin/cdxgen.js",
    "test": "deno run --allow-read --allow-env --allow-run --allow-net --allow-write --allow-sys npm:poku@4.5.0 --denoAllow=read,run,env,net,write,sys test/deno",
    "lint:check": "biome check *",
    "lint": "biome check --apply-unsafe *",
    "gen-types": "npx -p typescript tsc"
  },
  "imports": {
    "yaml": "npm:yaml@2.9.1",
    "@isaacs/string-locale-compare": "npm:@isaacs/string-locale-compare@1.1.0",
    "@npmcli/fs": "npm:@npmcli/fs@6.0.0",
    "@npmcli/map-workspaces": "npm:@npmcli/map-workspaces@6.0.0",
    "@npmcli/name-from-folder": "npm:@npmcli/name-from-folder@5.0.0",
    "@npmcli/package-json": "npm:@npmcli/package-json@8.0.0",
    "common-ancestor-path": "npm:common-ancestor-path@2.0.0",
    "json-stringify-nice": "npm:json-stringify-nice@1.1.4",
    "npm-package-arg": "npm:npm-package-arg@14.0.0",
    "parse-conflict-json": "npm:parse-conflict-json@6.0.0",
    "read-package-json-fast": "npm:read-package-json-fast@6.0.0",
    "treeverse": "npm:treeverse@3.0.0",
    "walk-up-path": "npm:walk-up-path@4.0.0",
    "@appthreat/atom": "npm:@appthreat/atom@3.1.1",
    "@cdxgen/cdx-hbom": "npm:@cdxgen/cdx-hbom@0.5.1",
    "@cdxgen/cdx-proto": "npm:@cdxgen/cdx-proto@2.3.0",
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@2.16.0",
    "@babel/parser": "npm:@babel/parser@8.0.6",
    "@babel/traverse": "npm:@babel/traverse@8.0.6",
    "ajv": "npm:ajv@8.20.0",
    "ajv-formats": "npm:ajv-formats@3.0.1",
    "edn-data": "npm:edn-data@1.2.2",
    "glob": "npm:glob@13.0.6",
    "node-stream-zip": "npm:node-stream-zip@1.16.0",
    "@cdxgen/cdx-purl": "npm:@cdxgen/cdx-purl@0.0.6",
    "semver": "npm:semver@7.8.5",
    "ssri": "npm:ssri@14.0.0",
    "tar": "npm:tar@7.5.22",
    "yargs": "npm:yargs@18.2.0",
    "body-parser": "npm:body-parser@2.3.0",
    "compression": "npm:compression@1.8.2",
    "connect": "npm:connect@3.7.0",
    "jsonata": "npm:jsonata@2.2.2",
    "smol-toml": "npm:smol-toml@1.9.0",
    "@cdxgen/safer-exec": "npm:@cdxgen/safer-exec@1.0.1",
    "@cdxgen/cdxgen-plugins-bin": "npm:@cdxgen/cdxgen-plugins-bin@4.1.1",
    "undici": "npm:undici@8.11.2",
    "@appthreat/atom-parsetools": "npm:@appthreat/atom-parsetools@1.10.0"
  }
}
